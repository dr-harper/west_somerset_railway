[debug] [2026-08-29T15:28:19.764Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-wsr:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // A verifier is anyone with a document under /verifiers keyed by uid.\n    // Membership is granted out of band (admin SDK), never self-served.\n    function isVerifier() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/verifiers/$(request.auth.uid));\n    }\n\n    // Episodes are written only by the detection pipeline, which uses the\n    // admin SDK and bypasses these rules. Anyone may read them; a verifier\n    // may set the verification fields and nothing else.\n    match /episodes/{episodeId} {\n      allow read: if true;\n      allow create, delete: if false;\n      allow update: if isVerifier()\n        && request.resource.data.diff(resource.data).affectedKeys()\n             .hasOnly(['status', 'verification']);\n    }\n\n    // Verifier membership is readable by the signed-in user, writable only\n    // by the admin SDK.\n    match /verifiers/{uid} {\n      allow read: if request.auth != null && request.auth.uid == uid;\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
