# Firebase — optional. Without these the app runs on the static timetable
# and the /verify page explains that verification is unavailable.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firestore emulator:
#   VITE_FIREBASE_PROJECT_ID=demo-wsr
#   VITE_FIRESTORE_EMULATOR=localhost:8085
VITE_FIRESTORE_EMULATOR=
