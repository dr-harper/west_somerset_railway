rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A verifier is anyone with a document under /verifiers keyed by uid.
    // Membership is granted out of band (admin SDK), never self-served.
    function isVerifier() {
      return request.auth != null
        && exists(/databases/$(database)/documents/verifiers/$(request.auth.uid));
    }

    // Episodes are written only by the detection pipeline, which uses the
    // admin SDK and bypasses these rules. Anyone may read them; a verifier
    // may set the verification fields and nothing else.
    match /episodes/{episodeId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isVerifier()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'verification']);
    }

    // Verifier membership is readable by the signed-in user, writable only
    // by the admin SDK.
    match /verifiers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
